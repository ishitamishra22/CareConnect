rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Patient medical documents storage:
    // Strictly restricted to the owning patient UID and authorized healthcare access.
    // Administrators are strictly denied blanket write or read access.
    match /documents/{patientId}/{documentId} {
      allow read: if isAuthenticated() && request.auth.uid == patientId;
      allow write: if isAuthenticated() && request.auth.uid == patientId;
    }

    // Doctor and Hospital profile public and owner assets
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Default rule: deny any unmatched path
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
