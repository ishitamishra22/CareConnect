rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        getUserData().role == role &&
        getUserData().active == true;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isDoctor() {
      return hasRole('DOCTOR');
    }

    function isHospitalAdmin() {
      return hasRole('HOSPITAL') || hasRole('HOSPITAL_ADMIN');
    }

    function isHospitalAdminOf(hospitalId) {
      return isAdmin() || (isHospitalAdmin() && getUserData().linkedHospitalId == hospitalId);
    }

    // =========================================================================
    // SECTION A: Shared Authentication Core & User Profiles
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());

      allow create: if isAuthenticated() && (
        (
          isAdmin() &&
          request.resource.data.role in ['DOCTOR', 'HOSPITAL'] &&
          request.resource.data.uid == userId
        ) ||
        (
          request.auth.uid == userId &&
          request.resource.data.uid == userId &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.linkedDoctorId == null &&
          request.resource.data.linkedHospitalId == null &&
          request.resource.data.doctorId == null &&
          request.resource.data.hospitalId == null &&
          request.resource.data.active == request.resource.data.isApproved &&
          (
            (
              request.resource.data.role == 'PATIENT' &&
              request.resource.data.active == true
            ) ||
            (
              request.resource.data.role in ['DOCTOR', 'HOSPITAL'] &&
              request.resource.data.active == false &&
              request.resource.data.approvalStatus == 'PENDING' &&
              request.resource.data.createdBy == 'self_registration'
            )
          )
        )
      );

      allow update: if isAuthenticated() && (
        (
          isAdmin() &&
          resource.data.role != 'ADMIN' &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.uid == resource.data.uid
        ) ||
        (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'phoneNumber', 'lastLoginAt']) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.isApproved == resource.data.isApproved
        )
      );

      allow delete: if false;
    }

    // =========================================================================
    // SECTION A-1: Administrator Audit Logs
    // =========================================================================
    match /adminAuditLogs/{logId} {
      // Create-only for Admins. No client update or delete permitted.
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // =========================================================================
    // SECTION B (Temporary): Patients, Records, Documents, Bookings & Admissions
    // =========================================================================
    match /patients/{patientId} {
      // Only the patient can access their own profile.
      allow read, write: if isOwner(patientId);

      match /records/{recordId} {
        // Only the patient can access their medical records.
        allow read, write: if isOwner(patientId);
      }

      match /documents/{docId} {
        // Only the patient can access their medical documents.
        allow read, write: if isOwner(patientId);
      }
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        (
          isDoctor() &&
          getUserData().linkedDoctorId == resource.data.doctorId
        ) ||
        isHospitalAdminOf(resource.data.hospitalId)
      );
      allow create: if hasRole('PATIENT') &&
    request.resource.data.patientId == request.auth.uid;
      allow update: if isAuthenticated() &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.hospitalId == resource.data.hospitalId &&
        request.resource.data.doctorId == resource.data.doctorId && (
        (
          hasRole('PATIENT') &&
          request.auth.uid == resource.data.patientId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status']) &&
          request.resource.data.status == 'CANCELLED'
        ) ||
        (
          isDoctor() &&
          getUserData().linkedDoctorId == resource.data.doctorId
        ) ||
        isHospitalAdminOf(resource.data.hospitalId)
      );
      allow delete: if isAdmin();
    }

    match /admissions/{admissionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        isHospitalAdminOf(resource.data.hospitalId)
      );
      allow create: if hasRole('PATIENT') &&
    request.resource.data.patientId == request.auth.uid;
      allow update: if isAuthenticated() &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.hospitalId == resource.data.hospitalId && (
        isHospitalAdminOf(resource.data.hospitalId)
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // SECTION C (Temporary): Hospitals, Doctors, Reviews & Catalogs
    // =========================================================================
    match /hospitals/{hospitalId} {
      allow read: if true; // Public directory for hospital search
      allow write: if isAdmin() || isHospitalAdminOf(hospitalId);
    }

    match /doctors/{doctorId} {
      allow read: if true; // Public directory for doctor search
      allow write: if isAdmin() ||
        (isDoctor() && getUserData().linkedDoctorId == doctorId) ||
        (isHospitalAdmin() &&
          getUserData().linkedHospitalId == resource.data.hospitalId &&
          request.resource.data.hospitalId == resource.data.hospitalId);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /slotLocks/{lockId} {
      // Reserved for future server-validated slot locking.
      allow read, write: if false;
    }
  }
}
