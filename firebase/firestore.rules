rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isDoctor() {
      return hasRole('DOCTOR');
    }

    function isHospitalAdmin() {
      return hasRole('HOSPITAL') || hasRole('HOSPITAL_ADMIN');
    }

    function isHospitalAdminOf(hospitalId) {
      return isAdmin() || (isHospitalAdmin() && getUserData().linkedHospitalId == hospitalId);
    }

    // =========================================================================
    // SECTION A: Shared Authentication Core & User Profiles
    // =========================================================================
    match /users/{userId} {
      // Read: Users can read their own profile; admins can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Create:
      // 1. Authenticated Admin can provision DOCTOR or HOSPITAL accounts.
      //    Admin can NEVER create another ADMIN account through client rules.
      // 2. Or, a self-registered user may only create a PATIENT role profile under their own UID.
      allow create: if isAuthenticated() && (
        (isAdmin() && (request.resource.data.role == 'DOCTOR' || request.resource.data.role == 'HOSPITAL')) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == 'PATIENT' &&
          request.resource.data.active == true &&
          (!('linkedDoctorId' in request.resource.data) || request.resource.data.linkedDoctorId == null) &&
          (!('linkedHospitalId' in request.resource.data) || request.resource.data.linkedHospitalId == null)
        )
      );

      // Update:
      // 1. Admin can update non-Admin profiles (displayName, active, linkedDoctorId, linkedHospitalId)
      //    Admins CANNOT change roles, cannot modify their own active status, and cannot modify other Admin accounts.
      // 2. Normal user can only update their own non-security profile fields
      //    (cannot change role, active status, linkedDoctorId, or linkedHospitalId).
      allow update: if isAuthenticated() && (
        (
          isAdmin() &&
          resource.data.role != 'ADMIN' &&
          request.resource.data.role == resource.data.role
        ) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.active == resource.data.active &&
          request.resource.data.linkedDoctorId == resource.data.linkedDoctorId &&
          request.resource.data.linkedHospitalId == resource.data.linkedHospitalId
        )
      );

      // Delete: Strictly disallowed via client SDK
      allow delete: if false;
    }

    // =========================================================================
    // SECTION A-1: Administrator Audit Logs
    // =========================================================================
    match /adminAuditLogs/{logId} {
      // Create-only for Admins. No client update or delete permitted.
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // =========================================================================
    // SECTION B (Temporary): Patients, Records, Documents, Bookings & Admissions
    // =========================================================================
    match /patients/{patientId} {
      // Patient profile root: patient owner, doctor, or hospital admin
      allow read, write: if isAuthenticated() && (request.auth.uid == patientId || isDoctor() || isHospitalAdmin());

      // Confidential Medical Records: Strictly patient owner and treating doctors.
      // System Admins are strictly forbidden from viewing confidential clinical records.
      match /records/{recordId} {
        allow read: if isAuthenticated() && (request.auth.uid == patientId || isDoctor());
        allow write: if isAuthenticated() && (request.auth.uid == patientId || isDoctor());
      }

      // Confidential Medical Documents: Strictly patient owner and treating doctors.
      // System Admins are strictly forbidden from viewing confidential medical documents.
      match /documents/{docId} {
        allow read: if isAuthenticated() && (request.auth.uid == patientId || isDoctor());
        allow write: if isAuthenticated() && (request.auth.uid == patientId || isDoctor());
      }
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId ||
        isHospitalAdminOf(resource.data.hospitalId)
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId ||
        isHospitalAdminOf(resource.data.hospitalId)
      );
      allow delete: if isAdmin();
    }

    match /admissions/{admissionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        isHospitalAdminOf(resource.data.hospitalId)
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        isHospitalAdminOf(resource.data.hospitalId)
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // SECTION C (Temporary): Hospitals, Doctors, Reviews & Catalogs
    // =========================================================================
    match /hospitals/{hospitalId} {
      allow read: if true; // Public directory for hospital search
      allow write: if isAdmin() || isHospitalAdminOf(hospitalId);
    }

    match /doctors/{doctorId} {
      allow read: if true; // Public directory for doctor search
      allow write: if isAuthenticated() && (isAdmin() || isDoctor() || isHospitalAdmin());
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /slotLocks/{lockId} {
      allow read, write: if isAuthenticated();
    }
  }
}
